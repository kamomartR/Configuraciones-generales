    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# 1. Cargar API de Revit\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 2. Cargar Servicios de Dynamo\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nopt = Options()\r\nopt.DetailLevel = ViewDetailLevel.Fine\r\nopt.ComputeReferences = True\r\nopt.IncludeNonVisibleObjects = True\r\n\r\n# ============================================================\r\n# FUNCIONES AUXILIARES BLINDADAS\r\n# ============================================================\r\n\r\ndef es_solido_valido(s):\r\n    \"\"\"Valida si un sólido de Revit es cerrado, tiene caras y volumen positivo.\"\"\"\r\n    if s is None:\r\n        return False\r\n    try:\r\n        if s.Faces.IsEmpty:\r\n            return False\r\n        return s.Volume > 0.00001\r\n    except Exception:\r\n        return False\r\n\r\ndef obtener_solidos(element):\r\n    \"\"\"Extrae todos los sólidos geométricos reales protegiendo contra excepciones.\"\"\"\r\n    solidos = []\r\n    try:\r\n        geom = element.get_Geometry(opt)\r\n        if geom is None:\r\n            return solidos\r\n        \r\n        for obj in geom:\r\n            if isinstance(obj, Solid):\r\n                if es_solido_valido(obj):\r\n                    solidos.append(obj)\r\n            elif isinstance(obj, GeometryInstance):\r\n                inst_geom = obj.GetInstanceGeometry()\r\n                if inst_geom:\r\n                    for s in inst_geom:\r\n                        if isinstance(s, Solid) and es_solido_valido(s):\r\n                            solidos.append(s)\r\n    except Exception:\r\n        pass\r\n    return solidos\r\n\r\n# ============================================================\r\n# PROCESAMIENTO POR CATEGORÍA\r\n# ============================================================\r\n\r\ndef procesar_muro(wall, solidos):\r\n    \"\"\"Calcula volumen, área útil y longitud de muros rectos o curvos.\"\"\"\r\n    # Descartar muros cortina\r\n    try:\r\n        wall_type = doc.GetElement(wall.GetTypeId())\r\n        if hasattr(wall_type, \"Kind\") and wall_type.Kind == WallKind.Curtain:\r\n            return None, None, None\r\n    except Exception:\r\n        pass\r\n\r\n    # 1. Volumen nativo\r\n    p_vol = wall.get_Parameter(BuiltInParameter.HOST_VOLUME_COMPUTED)\r\n    vol = p_vol.AsDouble() if (p_vol and p_vol.HasValue and p_vol.AsDouble() > 0.0001) else sum(s.Volume for s in solidos)\r\n\r\n    # 2. Longitud nativa / eje\r\n    longitud = None\r\n    if isinstance(wall.Location, LocationCurve):\r\n        longitud = wall.Location.Curve.Length\r\n\r\n    # 3. Área nativa\r\n    area_util = None\r\n    p_area = wall.get_Parameter(BuiltInParameter.HOST_AREA_COMPUTED)\r\n    if p_area and p_area.HasValue and p_area.AsDouble() > 0.0001:\r\n        area_util = p_area.AsDouble()\r\n    else:\r\n        caras_laterales = []\r\n        for s in solidos:\r\n            for face in s.Faces:\r\n                bb = face.GetBoundingBox()\r\n                u_mid = (bb.Min.U + bb.Max.U) / 2.0\r\n                v_mid = (bb.Min.V + bb.Max.V) / 2.0\r\n                try:\r\n                    normal = face.ComputeNormal(UV(u_mid, v_mid))\r\n                    if abs(normal.Z) < 0.2:\r\n                        caras_laterales.append(face.Area)\r\n                except Exception:\r\n                    continue\r\n\r\n        if caras_laterales:\r\n            caras_laterales.sort(reverse=True)\r\n            area_util = caras_laterales[0]\r\n\r\n    return vol, area_util, longitud\r\n\r\ndef procesar_viga_exacta(viga, solidos):\r\n    \"\"\"Calcula volumen y longitud física real de vigas.\"\"\"\r\n    if not solidos:\r\n        return 0.0, None, 0.0\r\n\r\n    vol_total = sum(s.Volume for s in solidos)\r\n    \r\n    if len(solidos) > 1:\r\n        longitud_total = 0.0\r\n        for s in solidos:\r\n            aristas_m = sorted([e.AsCurve().Length for e in s.Edges], reverse=True)\r\n            if aristas_m:\r\n                longitud_total += aristas_m[0]\r\n        return vol_total, None, longitud_total\r\n\r\n    s = solidos[0]\r\n    aristas = [e.AsCurve() for e in s.Edges if e.AsCurve().Length > 0.01]\r\n    if not aristas:\r\n        return vol_total, None, 0.0\r\n\r\n    aristas_ordenadas = sorted(aristas, key=lambda c: c.Length, reverse=True)\r\n    longitudes = [c.Length for c in aristas_ordenadas]\r\n\r\n    longitud_elegida = longitudes[0]\r\n    if len(longitudes) >= 3:\r\n        if abs(longitudes[1] - longitudes[2]) < 0.005 and abs(longitudes[0] - longitudes[1]) > 0.005:\r\n            longitud_elegida = longitudes[1]\r\n\r\n    return vol_total, None, longitud_elegida\r\n\r\ndef procesar_columna(col, solidos):\r\n    \"\"\"Calcula volumen y altura vertical neta de columnas.\"\"\"\r\n    p_vol = col.get_Parameter(BuiltInParameter.HOST_VOLUME_COMPUTED)\r\n    vol = p_vol.AsDouble() if (p_vol and p_vol.HasValue and p_vol.AsDouble() > 0.00001) else sum(s.Volume for s in solidos)\r\n\r\n    altura = None\r\n    for bip in (BuiltInParameter.INSTANCE_LENGTH_PARAM, BuiltInParameter.STRUCTURAL_FRAME_CUT_LENGTH):\r\n        p = col.get_Parameter(bip)\r\n        if p and p.HasValue and p.AsDouble() > 0.0001:\r\n            altura = p.AsDouble()\r\n            break\r\n\r\n    if altura is None and solidos:\r\n        bb = col.get_BoundingBox(None)\r\n        if bb:\r\n            altura = abs(bb.Max.Z - bb.Min.Z)\r\n\r\n    return vol, None, altura\r\n\r\ndef procesar_tuberia(pipe, solidos):\r\n    \"\"\"Calcula longitud de tuberías.\"\"\"\r\n    longitud = None\r\n    if isinstance(pipe.Location, LocationCurve):\r\n        longitud = pipe.Location.Curve.Length\r\n    else:\r\n        p_len = pipe.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH)\r\n        if p_len and p_len.HasValue:\r\n            longitud = p_len.AsDouble()\r\n\r\n    area_ext = None\r\n    p_area = pipe.get_Parameter(BuiltInParameter.RBS_CURVE_SURFACE_AREA)\r\n    if p_area and p_area.HasValue and p_area.AsDouble() > 0.0001:\r\n        area_ext = p_area.AsDouble()\r\n\r\n    return None, area_ext, longitud\r\n\r\ndef procesar_ducto(duct, solidos):\r\n    \"\"\"Calcula longitud y área de conductos.\"\"\"\r\n    longitud = None\r\n    if isinstance(duct.Location, LocationCurve):\r\n        longitud = duct.Location.Curve.Length\r\n    else:\r\n        p_len = duct.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH)\r\n        if p_len and p_len.HasValue:\r\n            longitud = p_len.AsDouble()\r\n\r\n    area_ext = None\r\n    p_area = duct.get_Parameter(BuiltInParameter.RBS_CURVE_SURFACE_AREA)\r\n    if p_area and p_area.HasValue and p_area.AsDouble() > 0.0001:\r\n        area_ext = p_area.AsDouble()\r\n\r\n    return None, area_ext, longitud\r\n\r\ndef procesar_part(part, solidos):\r\n    \"\"\"Calcula volumen y área útil para piezas (Parts).\"\"\"\r\n    vol = sum(s.Volume for s in solidos)\r\n    area_util = None\r\n    caras_verticales = []\r\n    for s in solidos:\r\n        for face in s.Faces:\r\n            bb = face.GetBoundingBox()\r\n            u_mid = (bb.Min.U + bb.Max.U) / 2.0\r\n            v_mid = (bb.Min.V + bb.Max.V) / 2.0\r\n            try:\r\n                norm = face.ComputeNormal(UV(u_mid, v_mid))\r\n                if abs(norm.Z) < 0.2:\r\n                    caras_verticales.append(face.Area)\r\n            except Exception:\r\n                continue\r\n\r\n    if caras_verticales:\r\n        area_util = max(caras_verticales)\r\n    return vol, area_util, None\r\n\r\ndef procesar_piso(floor, solidos):\r\n    \"\"\"Calcula volumen y área superior para losas.\"\"\"\r\n    p_vol = floor.get_Parameter(BuiltInParameter.HOST_VOLUME_COMPUTED)\r\n    vol = p_vol.AsDouble() if (p_vol and p_vol.HasValue) else sum(s.Volume for s in solidos)\r\n\r\n    area_sup = 0.0\r\n    for s in solidos:\r\n        for face in s.Faces:\r\n            bb = face.GetBoundingBox()\r\n            u_mid = (bb.Min.U + bb.Max.U) / 2.0\r\n            v_mid = (bb.Min.V + bb.Max.V) / 2.0\r\n            try:\r\n                norm = face.ComputeNormal(UV(u_mid, v_mid))\r\n                if norm.Z > 0.8:\r\n                    area_sup += face.Area\r\n            except Exception:\r\n                continue\r\n\r\n    return vol, (area_sup if area_sup > 0.0001 else None), None\r\n\r\n# ============================================================\r\n# BUCLE PRINCIPAL\r\n# ============================================================\r\n\r\ncollector = FilteredElementCollector(doc).WhereElementIsNotElementType().ToElements()\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ncontador = 0\r\n\r\nfor el in collector:\r\n    if el.Category is None or el.Category.CategoryType != CategoryType.Model:\r\n        continue\r\n\r\n    cat_id = el.Category.Id.IntegerValue\r\n    solidos = obtener_solidos(el)\r\n    \r\n    if not solidos and not hasattr(el, \"Location\"):\r\n        continue\r\n\r\n    v_val, a_val, l_val = None, None, None\r\n\r\n    try:\r\n        # 1. MUROS (se procesan SIEMPRE, incluso si tienen Parts)\r\n        if cat_id == int(BuiltInCategory.OST_Walls):\r\n            v_val, a_val, l_val = procesar_muro(el, solidos)\r\n\r\n        # 2. VIGAS\r\n        elif cat_id == int(BuiltInCategory.OST_StructuralFraming):\r\n            v_val, a_val, l_val = procesar_viga_exacta(el, solidos)\r\n\r\n        # 3. COLUMNAS / PILARES\r\n        elif cat_id in (int(BuiltInCategory.OST_Columns), int(BuiltInCategory.OST_StructuralColumns)):\r\n            v_val, a_val, l_val = procesar_columna(el, solidos)\r\n\r\n        # 4. TUBERÍAS\r\n        elif cat_id == int(BuiltInCategory.OST_PipeCurves):\r\n            v_val, a_val, l_val = procesar_tuberia(el, solidos)\r\n\r\n        # 5. DUCTOS\r\n        elif cat_id == int(BuiltInCategory.OST_DuctCurves):\r\n            v_val, a_val, l_val = procesar_ducto(el, solidos)\r\n\r\n        # 6. PIEZAS (PARTS)\r\n        elif cat_id == int(BuiltInCategory.OST_Parts):\r\n            v_val, a_val, l_val = procesar_part(el, solidos)\r\n\r\n        # 7. SUELOS / LOSAS\r\n        elif cat_id == int(BuiltInCategory.OST_Floors):\r\n            v_val, a_val, l_val = procesar_piso(el, solidos)\r\n\r\n        # 8. ELEMENTOS GENÉRICOS\r\n        else:\r\n            v_val = sum(s.Volume for s in solidos) if solidos else None\r\n\r\n        # Asignación de parámetros\r\n        mapa = {\r\n            \"VOLUMEN INTEGRADO\": v_val,\r\n            \"AREA INTEGRADO\": a_val,\r\n            \"LONGITUD INTEGRADO\": l_val\r\n        }\r\n\r\n        tocado = False\r\n        for p_name, val in mapa.items():\r\n            param = el.LookupParameter(p_name)\r\n            if param and not param.IsReadOnly:\r\n                if val is not None and val > 0.00001:\r\n                    param.Set(float(val))\r\n                    tocado = True\r\n                else:\r\n                    try:\r\n                        param.ClearValue()\r\n                    except Exception:\r\n                        param.Set(0.0)\r\n                    tocado = True\r\n\r\n        if tocado:\r\n            contador += 1\r\n\r\n    except Exception:\r\n        continue\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = f\"Ejecución completada con éxito. Elementos actualizados: {contador}\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5ddd13013cce4336b7646d2f58d58a63",
