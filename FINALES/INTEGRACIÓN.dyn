    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Importar Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Importar DocumentManager y TransactionManager\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Recolectar TODOS los elementos que no sean tipos\r\ncollector = FilteredElementCollector(doc).WhereElementIsNotElementType().ToElements()\r\n\r\nresultados = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor e in collector:\r\n    try:\r\n        # Validación de categoría para CPython3\r\n        if e.Category is None: \r\n            continue\r\n        \r\n        nombre_mat = None\r\n        type_id = e.GetTypeId()\r\n        \r\n        # Validación de ElementId compatible\r\n        e_type = doc.GetElement(type_id) if type_id != ElementId.InvalidElementId else None\r\n        \r\n        # ESTRATEGIA 1: Estructuras compuestas (Muros, Suelos, Techos)\r\n        if e_type is not None and hasattr(e_type, \"GetCompoundStructure\"):\r\n            comp_struc = e_type.GetCompoundStructure()\r\n            if comp_struc is not None:\r\n                layers = comp_struc.GetLayers()\r\n                if layers:\r\n                    m_id = layers[0].MaterialId\r\n                    if m_id != ElementId.InvalidElementId:\r\n                        material_elem = doc.GetElement(m_id)\r\n                        if material_elem:\r\n                            nombre_mat = material_elem.Name\r\n\r\n        # ESTRATEGIA 2: Parámetros de Material en Instancia\r\n        if not nombre_mat:\r\n            for p_name in [\"Material\", \"Structural Material\", \"Material estructural\"]:\r\n                p = e.LookupParameter(p_name)\r\n                if p is not None and p.HasValue:\r\n                    m_id = p.AsElementId()\r\n                    if m_id != ElementId.InvalidElementId:\r\n                        material_elem = doc.GetElement(m_id)\r\n                        if material_elem:\r\n                            nombre_mat = material_elem.Name\r\n                            break\r\n\r\n        # ESTRATEGIA 3: Buscar en el Tipo\r\n        if not nombre_mat and e_type is not None:\r\n            p = e_type.LookupParameter(\"Material\")\r\n            if p is not None and p.HasValue:\r\n                m_id = p.AsElementId()\r\n                if m_id != ElementId.InvalidElementId:\r\n                    material_elem = doc.GetElement(m_id)\r\n                    if material_elem:\r\n                        nombre_mat = material_elem.Name\r\n\r\n        # ESCRIBIR RESULTADO\r\n        if nombre_mat:\r\n            param_destino = e.LookupParameter(\"MATERIAL INTEGRADO\")\r\n            if param_destino is not None and not param_destino.IsReadOnly:\r\n                param_destino.Set(nombre_mat)\r\n                resultados.append(f\"{e.Category.Name}: {nombre_mat}\")\r\n                \r\n    except Exception:\r\n        continue\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Salida formateada para Python 3\r\nOUT = f\"Se procesaron {len(resultados)} materiales con éxito.\" if resultados else \"No se encontraron materiales para asignar.\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "182332a000244b5da8cea31bd0aa19f5",
