    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Cargar API de Revit\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView # Obtiene la vista actual\r\n\r\n# --- DICCIONARIO DE MAPEO ---\r\nmapping = {\r\n    \"Walls\": \"MUROS\", \"Muros\": \"MUROS\",\r\n    \"Structural Columns\": \"COLUMNAS\", \"Pilares estructurales\": \"COLUMNAS\",\r\n    \"Columns\": \"COLUMNAS\", \"Pilares\": \"COLUMNAS\",\r\n    \"Windows\": \"VENTANAS\", \"Ventanas\": \"VENTANAS\",\r\n    \"Doors\": \"PUERTAS\", \"Puertas\": \"PUERTAS\",\r\n    \"Floors\": \"PISOS / PLACAS\", \"Suelos\": \"PISOS / PLACAS\",\r\n    \"Furniture\": \"MOBILIARIO\", \"Mobiliario\": \"MOBILIARIO\",\r\n    \"Plumbing Fixtures\": \"APARATOS SANITARIOS\", \"Aparatos sanitarios\": \"APARATOS SANITARIOS\",\r\n    \"Structural Framing\": \"VIGAS\", \"Armazón estructural\": \"VIGAS\",\r\n    \"Roofs\": \"CUBIERTAS\", \"Cubiertas\": \"CUBIERTAS\",\r\n    \"Stairs\": \"ESCALERAS\", \"Escaleras\": \"ESCALERAS\"\r\n}\r\n\r\n# Colectar TODOS los elementos visibles en la vista activa que tengan categoría\r\ncollector = FilteredElementCollector(doc, view.Id)\\\r\n            .WhereElementIsNotElementType()\\\r\n            .ToElements()\r\n\r\nresults = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor item in collector:\r\n    # Ignorar elementos sin categoría (como líneas de detalle o planos de referencia)\r\n    if item.Category is None:\r\n        continue\r\n        \r\n    try:\r\n        cat_name = item.Category.Name\r\n        # Buscar traducción o usar nombre original en MAYÚSCULAS\r\n        simplified_name = mapping.get(cat_name, cat_name.upper())\r\n        \r\n        # Acceder al parámetro personalizado\r\n        param = item.LookupParameter(\"CLASIFICACIÓN\")\r\n        \r\n        if param and not param.IsReadOnly:\r\n            param.Set(simplified_name)\r\n            results.append(\"Asignado: \" + simplified_name)\r\n    except:\r\n        continue\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"Se procesaron \" + str(len(results)) + \" elementos en la vista actual.\"",
