    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Usamos el collector que te funcionó en el de materiales\r\ncollector = FilteredElementCollector(doc).WhereElementIsNotElementType().ToElements()\r\n\r\nparam_objetivo = \"NOMBRE INTEGRADO\"\r\nconteo_exito = 0\r\nlogs = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor e in collector:\r\n    try:\r\n        # 1. Obtener el nombre del tipo (TU_PVCS)\r\n        t_id = e.GetTypeId()\r\n        if t_id == ElementId.InvalidElementId: continue\r\n        \r\n        tipo_elem = doc.GetElement(t_id)\r\n        # Accedemos al BuiltInParameter del nombre para evitar problemas de idioma\r\n        nombre_tipo = tipo_elem.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\r\n\r\n        # 2. BUSCAR EL PARÁMETRO DE FORMA MANUAL (Más seguro que LookupParameter)\r\n        p_destino = None\r\n        for p in e.Parameters:\r\n            if p.Definition.Name == param_objetivo:\r\n                p_destino = p\r\n                break\r\n        \r\n        # 3. Intentar la escritura\r\n        if p_destino and not p_destino.IsReadOnly:\r\n            p_destino.Set(nombre_tipo)\r\n            conteo_exito += 1\r\n        \r\n    except Exception as ex:\r\n        continue\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Salida clara\r\nif conteo_exito > 0:\r\n    OUT = \"¡ÉXITO! Se actualizaron {} elementos.\".format(conteo_exito)\r\nelse:\r\n    OUT = \"Sigue dando 0. Posible causa: El parámetro 'NOMBRE INTEGRADO' no está asignado a la categoría de los elementos seleccionados.\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e1f8f5e09d8e4cd6bbf0eb551407f4d8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
