{
  "Uuid": "fdaeb9a9-669b-4345-8f84-bf38b2487669",
  "IsCustomNode": false,
  "Description": "",
  "Name": "CARGAR PARAMETRO COMPARTIDO INTEGRACIÓN",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# 1. Cargar API de Revit\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 2. Cargar Servicios de Dynamo\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\napp = doc.Application\r\n\r\n# --- CONFIGURACIÓN ---\r\nruta_txt = r\"C:\\Users\\DELL\\Documents\\CDE NORA\\PARAMETROS COMPARTIDOS.txt\"\r\n\r\nnombres_parametros = [\r\n    \"MATERIAL INTEGRADO\", \"NIVEL INTEGRADO\", \"CLASIFICACIÓN\", \r\n    \"AREA INTEGRADO\", \"LONGITUD INTEGRADO\", \"NOMBRE INTEGRADO\", \"VOLUMEN INTEGRADO\"\r\n]\r\n\r\n# 3. Cargar Archivo de Parámetros Compartidos\r\napp.SharedParametersFilename = ruta_txt\r\ndef_file = app.OpenSharedParameterFile()\r\n\r\nif def_file is None:\r\n    OUT = \"Error: No se pudo abrir el archivo TXT en la ruta especificada.\"\r\nelse:\r\n    # 4. Crear el CategorySet con categorías principales de modelo\r\n    cat_set = app.Create.NewCategorySet()\r\n    \r\n    for cat in doc.Settings.Categories:\r\n        # Solo categorías principales de modelo o anotación que permitan vinculación\r\n        if cat.AllowsBoundParameters and cat.CategoryType == CategoryType.Model:\r\n            cat_set.Insert(cat)\r\n\r\n    # 5. Ejecutar transacción\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    resultados = []\r\n\r\n    try:\r\n        # Compatibilidad de grupo entre versiones de Revit (Revit 2024+ usa GroupTypeId)\r\n        try:\r\n            grupo_final = GroupTypeId.IdentityData\r\n        except AttributeError:\r\n            grupo_final = BuiltInParameterGroup.PG_IDENTITY_DATA\r\n\r\n        binding_map = doc.ParameterBindings\r\n\r\n        for nombre in nombres_parametros:\r\n            p_def = None\r\n            for group in def_file.Groups:\r\n                p_def = group.Definitions.get_Item(nombre)\r\n                if p_def is not None:\r\n                    break\r\n            \r\n            if p_def is not None:\r\n                nuevo_binding = app.Create.NewInstanceBinding(cat_set)\r\n                \r\n                # Si el parámetro ya existe en el proyecto, se actualiza con ReInsert\r\n                if binding_map.Contains(p_def):\r\n                    binding_map.ReInsert(p_def, nuevo_binding, grupo_final)\r\n                    resultados.append(f\"Actualizado (ReInsert): {nombre}\")\r\n                else:\r\n                    binding_map.Insert(p_def, nuevo_binding, grupo_final)\r\n                    resultados.append(f\"Insertado nuevo: {nombre}\")\r\n            else:\r\n                resultados.append(f\"No hallado en TXT: {nombre}\")\r\n\r\n        OUT = \"\\n\".join(resultados)\r\n\r\n    except Exception as e:\r\n        OUT = f\"Error crítico: {str(e)}\"\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "2957fa0c1ba8450eb71d7dcae7910d2d",
      "NodeType": "PythonScriptNode",
